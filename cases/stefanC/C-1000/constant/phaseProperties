FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/caseParameters"

type    massTransferMultiphaseSystem;

phases  (solid liquid);

liquid
{
    type            pureMovingPhaseModel;
}

solid
{
    type            pureStaticSolidPhaseModel;
}

// Darcy damping of velocity in the ice (Voller & Prakash 1987)
interfacePorous
(
    (solid and liquid)
    {
        type            VollerPrakash;
        solidPhase      alpha.solid;
        Cu              1e7;
    }
);

// Freezing: liquid -> solid below Tm (C < 0)
massTransferModel
(
    (liquid to solid)
    {
        type            Lee;
        C               $Cfreeze;
        Tactivate       $Tm;
    }
);
