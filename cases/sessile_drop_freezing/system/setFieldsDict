FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/caseParameters"

defaultFieldValues
(
    volScalarFieldValue alpha.air    1
    volScalarFieldValue alpha.liquid 0
    volScalarFieldValue alpha.solid  0
);

regions
(
    // hemisphere sitting on the plate (sphere centred on the wall)
    sphereToCell
    {
        origin  (0 0 0);
        radius  $R;
        fieldValues
        (
            volScalarFieldValue alpha.air    0
            volScalarFieldValue alpha.liquid 1
        );
    }
);
