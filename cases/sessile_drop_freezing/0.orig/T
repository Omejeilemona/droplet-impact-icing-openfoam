#include "$FOAM_CASE/caseParameters"

dimensions      [0 0 0 1 0 0 0];
internalField   uniform $Tm;

boundaryField
{
    plate
    {
        type            fixedValue;
        value           uniform $Twall;
    }
    atmosphere
    {
        type            inletOutlet;
        inletValue      uniform $Tm;
        value           uniform $Tm;
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
    axis
    {
        type            empty;
    }
}
