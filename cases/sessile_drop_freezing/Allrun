#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
#------------------------------------------------------------------------------
# NP=1 (default) serial; NP=2 or more for parallel
NP=${NP:-1}
restore0Dir
runApplication blockMesh
runApplication setFields
if [ "$NP" -gt 1 ]
then
    sed -i "s/^numberOfSubdomains .*/numberOfSubdomains  $NP;/" system/decomposeParDict
    runApplication decomposePar
    runParallel icoReactingMultiphaseInterFoam
    runApplication reconstructPar
else
    runApplication icoReactingMultiphaseInterFoam
fi
touch case.foam
python3 postProcess/freezing.py . | tee log.freezing
#------------------------------------------------------------------------------
