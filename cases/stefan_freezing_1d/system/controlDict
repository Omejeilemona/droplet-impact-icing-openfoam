FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     icoReactingMultiphaseInterFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         100;

deltaT          1e-4;
adjustTimeStep  yes;
maxDeltaT       2e-3;
maxCo           1;
maxAlphaCo      1;
maxAlphaDdt     0.2;
maxDi           25;

writeControl    adjustable;
writeInterval   10;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable yes;

functions
{
    // ice volume -> front position s = V_ice / A,  A = 1e-8 m2
    iceVolume
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        fields          (alpha.solid);
        operation       volIntegrate;
        regionType      all;
        writeFields     false;
        writeControl    adjustableRunTime;
        writeInterval   0.5;
    }
    // temperature profile along the column
    Tprofile
    {
        type            sets;
        libs            (sampling);
        writeControl    adjustableRunTime;
        writeInterval   10;
        interpolationScheme cellPoint;
        setFormat       raw;
        fields          (T alpha.solid);
        sets
        {
            column
            {
                type    uniform;
                axis    y;
                start   (5e-5 0      5e-5);
                end     (5e-5 0.01   5e-5);
                nPoints 400;
            }
        }
    }
}
