#!/bin/sh
cd "${0%/*}" || exit                                # run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # tutorial run functions
#------------------------------------------------------------------------------
# Usage:  ./Allrun            parallel on NP=4 cores (default)
#         NP=1 ./Allrun       serial
#         NP=6 ./Allrun       six cores
NP=${NP:-4}

# --- derived run settings from caseParameters --------------------------------
# endTime   = contact time + tStarEnd * D0/U0
# maxDeltaT = 0.6 * capillary limit sqrt(rho_avg dx^3 / (2 pi sigma)), dx = R/N
eval $(awk '!/^[ \t]*\/\// && NF>=2 {gsub(";","",$2); print $1"="$2}' caseParameters \
       | grep -E '^(R|yc|Uimpact|tStarEnd|rhoL|rhoG|sigma|nr)=')
endTime=$(awk -v R=$R -v yc=$yc -v U=$Uimpact -v ts=$tStarEnd \
    'BEGIN{U=(U<0)?-U:U; printf "%.6g", (yc-R)/U + ts*2*R/U}')
maxDt=$(awk -v R=$R -v nr=$nr -v rl=$rhoL -v rg=$rhoG -v s=$sigma \
    'BEGIN{dx=6*R/nr; printf "%.3g", 0.6*sqrt(0.5*(rl+rg)*dx^3/(2*3.14159265*s))}')
sed -i "s/^endTime .*/endTime         $endTime;/"   system/controlDict
sed -i "s/^maxDeltaT .*/maxDeltaT       $maxDt;/"   system/controlDict
echo "endTime = $endTime s,  maxDeltaT = $maxDt s,  NP = $NP"

restore0Dir
runApplication blockMesh
runApplication checkMesh
runApplication setFields

if [ "$NP" -gt 1 ]
then
    sed -i "s/^numberOfSubdomains .*/numberOfSubdomains  $NP;/" system/decomposeParDict
    runApplication decomposePar
    runParallel interFoam
    runApplication reconstructPar
else
    runApplication interFoam
fi

touch case.foam                                     # ParaView reader file
python3 postProcess/spreading.py . | tee log.spreading

#------------------------------------------------------------------------------
