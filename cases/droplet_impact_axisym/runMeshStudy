#!/bin/bash
# Mesh-convergence study: copies this case into $OUT/N<cells per radius>,
# keeps cells square (nr = 6N, nz = 8N), runs each, then overlays beta(t).
#   usage:  ./runMeshStudy                       (N = 25 35 50, no-slip, OUT=../meshStudy)
#           ./runMeshStudy 25 50 70
#           SLIP=20e-6 OUT=../meshStudy_slip20um ./runMeshStudy
#           NP=6 ./runMeshStudy                  (cores per run)
cd "${0%/*}" || exit
Ns=${@:-25 35 50}
OUT=${OUT:-../meshStudy}
mkdir -p "$OUT"
cases=()
for N in $Ns; do
    c=$OUT/N$N
    rm -rf "$c"; mkdir -p "$c"
    cp -r 0.orig constant system postProcess caseParameters Allrun Allclean "$c"/
    sed -i "s/^nr .*/nr          $((6*N));/; s/^nz .*/nz          $((8*N));/" "$c/caseParameters"
    [ -n "$SLIP" ] && sed -i "s/^slipLength .*/slipLength  $SLIP;/" "$c/caseParameters"
    echo "=== N = $N  ($((6*N)) x $((8*N)) cells)  slip = ${SLIP:-0} ==="
    (cd "$c" && ./Allrun)
    cases+=("$c")
done
python3 postProcess/spreading.py "${cases[@]}" --overlay "$OUT/beta_t_mesh.png" --label nr
